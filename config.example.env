# --- required ---
SABNZBD_URL=http://192.168.x.x:8080
SABNZBD_API_KEY=your_sabnzbd_api_key

# --- speed limits in percent ---
THROTTLE_PERCENT=50
FULL_PERCENT=100

# --- mode: polling (optional, recommended) ---
# If JELLYFIN_URL and JELLYFIN_API_KEY are set, sabthrottle polls Jellyfin
# directly and the Webhook plugin is NOT required. Polling is the source of
# truth for active sessions, so no stop-event can ever be missed.
JELLYFIN_URL=http://192.168.x.x:8096
JELLYFIN_API_KEY=your_jellyfin_api_key
JELLYFIN_POLL_INTERVAL_SEC=15

# --- mode: webhook (used if polling is not configured) ---
# Shared secret expected in ?token=... or X-Webhook-Token header.
# Leave empty to disable auth.
WEBHOOK_TOKEN=

# Only react to streams whose item path contains this prefix.
# Useful if you only want to throttle while NZBDav-backed content is playing.
# Example: /mnt/user/nzbdav
NZBDAV_PATH_PREFIX=

# Drop sessions that haven't sent a heartbeat (PlaybackProgress) for this long.
SESSION_TIMEOUT_SEC=90
GC_INTERVAL_SEC=30

LISTEN_PORT=6811
LOG_LEVEL=INFO
