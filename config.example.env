# --- required ---
SABNZBD_URL=http://192.168.x.x:8080
SABNZBD_API_KEY=your_sabnzbd_api_key

# --- Jellyfin (polling mode) ---
JELLYFIN_URL=http://192.168.x.x:8096
JELLYFIN_API_KEY=your_jellyfin_api_key
JELLYFIN_POLL_INTERVAL_SEC=15

# --- defaults (also editable in the WebUI) ---
# These seed settings.json on first start. After that, the WebUI is the
# source of truth — env-var changes won't override a value the user has
# already set in the UI.
THROTTLE_PERCENT=50
FULL_PERCENT=100
# Optional: real line speed in Mbit/s. Used so percent rules can be
# displayed as MB/s and compared with absolute rules.
LINE_SPEED_MBIT=0

# --- optional ---
# Where rules.json and settings.json are persisted. The container declares
# /config as a VOLUME — point this at /mnt/user/appdata/sabthrottle on
# Unraid (the template does it for you).
CONFIG_DIR=/config

# Filter: only react to streams whose item path contains this prefix.
NZBDAV_PATH_PREFIX=

# Webhook mode (legacy / instant reaction) — shared secret.
WEBHOOK_TOKEN=

LISTEN_PORT=6811
LOG_LEVEL=INFO
