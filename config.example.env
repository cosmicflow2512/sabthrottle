# --- required ---
SABNZBD_URL=http://192.168.x.x:8080
SABNZBD_API_KEY=your_sabnzbd_api_key

# --- Jellyfin (polling mode) ---
JELLYFIN_URL=http://192.168.x.x:8096
JELLYFIN_API_KEY=your_jellyfin_api_key
JELLYFIN_POLL_INTERVAL_SEC=15

# --- JDownloader 2 via MyJDownloader (optional) ---
# All three must be set to enable the JDownloader target.
# MYJD_DEVICE is the device name exactly as shown on my.jdownloader.org.
MYJD_EMAIL=
MYJD_PASSWORD=
MYJD_DEVICE=
# MYJD_APP_KEY=sabthrottle

# --- defaults (also editable in the WebUI) ---
# These seed settings.json on first start. After that, the WebUI is the
# source of truth — env-var changes won't override a value the user has
# already set in the UI.
# Total download budget (percent of line speed) shared by ALL downloaders
# while Jellyfin is streaming:
STREAM_BUDGET_PERCENT=50
# SABnzbd default limit when no rule and no stream is active:
FULL_PERCENT=100
# Optional: real line speed in Mbit/s. Reference for all percent values.
LINE_SPEED_MBIT=0

# --- optional ---
# Where rules.json, settings.json and state.json are persisted. The
# container declares /config as a VOLUME — point this at
# /mnt/user/appdata/sabthrottle on Unraid (the template does it for you).
CONFIG_DIR=/config

# Filter: only react to streams whose item path contains this prefix.
NZBDAV_PATH_PREFIX=

# Webhook mode (instant reaction) — shared secret.
WEBHOOK_TOKEN=

LISTEN_PORT=6811
LOG_LEVEL=INFO
